# Dependencies & build artifacts (the image rebuilds these)
node_modules
.next
.yarn
.pnp
.pnp.js

# Persistent data (mounted as volumes at runtime, never baked into image)
media
data
payload.db
payload.db-journal
payload.db-shm
payload.db-wal

# Runtime / dev artifacts
cms.log
.cms.pid
.next/cache

# Cloudflared (mounted at runtime)
cloudflared/cloudflared.log
cloudflared/cloudflared.pid

# Local env files (passed via env_file in compose)
.env
.env.*.local

# VCS, IDE, OS
.git
.gitignore
.idea
.vscode
.DS_Store

# Tests / coverage / playwright (not needed in production image)
coverage
test-results
playwright-report
blob-report
playwright/.cache
playwright.config.ts
tests
test.env
vitest.config.mts
vitest.setup.ts

# Docs
*.md
docs

# Dev-only seeding scripts (reference paths outside the project)
scripts

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Misc
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
