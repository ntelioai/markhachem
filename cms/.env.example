# Local SQLite database (file path). For Docker deploys, this is overridden in
# docker-compose.yml to /app/data/payload.db so the DB lives on the mounted volume.
DATABASE_URI=file:./payload.db

# Long random string used to sign Payload's auth tokens. Generate with:
#   openssl rand -base64 48
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL — used for canonical links, sitemap, OG/Twitter metadata.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.markhachem.com
